[node name="Elder" parent="Entities" unique_id=416845030 instance=ExtResource("3_hvhbj")]
position = Vector2(368, 208)
dialogue = "Vương miện của làng đã bị Kỵ sĩ Tro mang đến thành cổ phía đông.
Hãy mời Mira và Bran cùng đi. Mở túi đồ để trang bị kiếm và giáp trước khi chiến đấu.
Nếu bị thương, trở lại đây. Ta sẽ giúp cả đội nghỉ ngơi."
